#!/usr/bin/env bash
set -euo pipefail

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# Compute plugin root (one level up from hooks/)
PLUGIN_ROOT=$(cd "$(dirname "$0")/.." && pwd)

# Language directive injected into every session. Single-quoted so nothing is
# interpolated (backticks/accents are literal), then JSON-escaped for embedding.
LANG_RULE_RAW='Idioma / Language: Fale com o usuário em português do Brasil (pt-BR) por padrão. Se o usuário escrever em outro idioma, espelhe o idioma dele na conversa. Independente do idioma da conversa, TODOS os artefatos do afyapowers (design.md, plan.md, review.md, completion.md, implementation-concerns.md e docs) DEVEM ser escritos SEMPRE em português do Brasil, seguindo estritamente os templates. Mantenha em inglês os termos técnicos/de produto usados convencionalmente em inglês (ex.: Tech Stack, endpoint, deploy, payload, breakpoint, Node Map, PR, merge, changelog); nunca traduza código, identificadores ou caminhos de arquivo.'
LANG_RULE=$(json_escape "$LANG_RULE_RAW")

# Discover preflight script path (handles agent-specific directory prefixes)
PREFLIGHT=$(find "$PLUGIN_ROOT/skills" -name "preflight.py" -path "*next*" 2>/dev/null | head -1)

# Discover setup script path (handles agent-specific directory prefixes)
SETUP=$(find "$PLUGIN_ROOT/skills" -name "setup.py" -path "*new*" 2>/dev/null | head -1)

# Warn if Python 3 is unavailable — afyapowers setup requires it.
# SessionStart cannot block, so this is a non-blocking warning only.
PYWARN=""
if ! command -v python3 >/dev/null 2>&1; then
  PYWARN="\\n$(json_escape "⚠️ Python 3 not found on PATH — afyapowers setup will not work. Install Python 3.9+.")"
fi

# Find .afyapowers directory relative to working directory
AFYA_DIR=".afyapowers"

# Jira ticket context, language re-injection, history rendering, telemetry and
# the status line live in the separate afyapowers-core plugin.

# Shared context suffix carried by every exit path.
CTX_SUFFIX="Plugin root: $(json_escape "$PLUGIN_ROOT")\\nPreflight script: $(json_escape "$PREFLIGHT")\\nSetup script: $(json_escape "$SETUP")${PYWARN}\\n\\n${LANG_RULE}"

# If no .afyapowers directory, still provide plugin root for script access
if [ ! -d "$AFYA_DIR" ]; then
  echo "{\"additionalContext\": \"$CTX_SUFFIX\"}"
  exit 0
fi

ACTIVE_FEATURE=""
ACTIVE_FILE="$AFYA_DIR/features/active"

# Try reading the active file first
if [ -f "$ACTIVE_FILE" ]; then
  ACTIVE_FEATURE=$(tr -d '\n\r' < "$ACTIVE_FILE")
  # Validate it points to an existing feature
  if [ ! -d "$AFYA_DIR/features/$ACTIVE_FEATURE" ]; then
    ACTIVE_FEATURE=""
  fi
fi

# Fallback: scan for features with in_progress phases
if [ -z "$ACTIVE_FEATURE" ]; then
  IN_PROGRESS_FEATURES=()
  for state_file in "$AFYA_DIR"/features/*/state.yaml; do
    [ -f "$state_file" ] || continue
    if grep -q "status: in_progress" "$state_file" 2>/dev/null; then
      feature_dir=$(dirname "$state_file")
      feature_slug=$(basename "$feature_dir")
      # Skip aborted features
      if grep -q "^status: aborted" "$state_file" 2>/dev/null; then
        continue
      fi
      IN_PROGRESS_FEATURES+=("$feature_slug")
    fi
  done

  if [ ${#IN_PROGRESS_FEATURES[@]} -eq 1 ]; then
    ACTIVE_FEATURE="${IN_PROGRESS_FEATURES[0]}"
  elif [ ${#IN_PROGRESS_FEATURES[@]} -gt 1 ]; then
    # Multiple in-progress features, list them
    FEATURE_LIST=$(printf ', %s' "${IN_PROGRESS_FEATURES[@]}")
    FEATURE_LIST="${FEATURE_LIST:2}"
    CONTEXT="Multiple features are in-progress: ${FEATURE_LIST}. Run /afyapowers:switch to select one, or /afyapowers:features to see all.\\n${CTX_SUFFIX}"
    echo "{\"additionalContext\": \"$CONTEXT\"}"
    exit 0
  fi
fi

# No active feature found
if [ -z "$ACTIVE_FEATURE" ]; then
  echo "{\"additionalContext\": \"$CTX_SUFFIX\"}"
  exit 0
fi

# Read state.yaml for the active feature
STATE_FILE="$AFYA_DIR/features/$ACTIVE_FEATURE/state.yaml"
if [ ! -f "$STATE_FILE" ]; then
  echo "{\"additionalContext\": \"$CTX_SUFFIX\"}"
  exit 0
fi

# Extract key fields from state.yaml
FEATURE_NAME_RAW=$(grep "^feature:" "$STATE_FILE" | sed 's/^feature: *//')
FEATURE_NAME="${FEATURE_NAME_RAW#\"}" ; FEATURE_NAME="${FEATURE_NAME%\"}"
FEATURE_NAME="${FEATURE_NAME#\'}" ; FEATURE_NAME="${FEATURE_NAME%\'}"
CURRENT_PHASE=$(grep "^current_phase:" "$STATE_FILE" | sed 's/^current_phase: *//')
FEATURE_STATUS=$(grep "^status:" "$STATE_FILE" | head -1 | sed 's/^status: *//')
CREATED_AT=$(grep "^created_at:" "$STATE_FILE" | sed 's/^created_at: *//')

# Collect artifacts
ARTIFACTS=""
ARTIFACT_DIR="$AFYA_DIR/features/$ACTIVE_FEATURE/artifacts"
if [ -d "$ARTIFACT_DIR" ]; then
  ARTIFACTS=$(ls "$ARTIFACT_DIR" 2>/dev/null | tr '\n' ', ' | sed 's/,$//')
fi

# Count plan tasks if in implement phase
TASK_INFO=""
PLAN_FILE="$ARTIFACT_DIR/plan.md"
if [ "$CURRENT_PHASE" = "implement" ] && [ -f "$PLAN_FILE" ]; then
  TOTAL=$(grep -c '^\- \[' "$PLAN_FILE" 2>/dev/null || echo "0")
  DONE=$(grep -c '^\- \[x\]' "$PLAN_FILE" 2>/dev/null || echo "0")
  TASK_INFO=" ($DONE of $TOTAL tasks completed)"
fi

# Build context message
CONTEXT="You have an active feature: \\\"$(json_escape "$FEATURE_NAME")\\\" (started ${CREATED_AT%T*})\\nCurrent phase: $(json_escape "$CURRENT_PHASE")${TASK_INFO}\\nArtifacts: $(json_escape "${ARTIFACTS:-none}")\\n\\nRun /afyapowers:status for details, or continue working on the current phase.\\n\\nIMPORTANT: You are operating within the afyapowers deterministic workflow. Do NOT advance phases autonomously. When the current phase is complete, suggest the user run /afyapowers:next.\\n\\n${CTX_SUFFIX}"

echo "{\"additionalContext\": \"$CONTEXT\"}"
