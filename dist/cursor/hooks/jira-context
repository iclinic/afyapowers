#!/usr/bin/env bash
set -euo pipefail

# UserPromptSubmit: the single owner of the Jira ticket flow.
#
# Context injected at SessionStart arrives before the first prompt and the
# model routinely ignores it when it starts acting (same lesson that moved
# lang-directive to per-skill injection), so everything happens here, injected
# WITH the user's prompt — the moment the model is deciding what to do.
#
# Every message carries the same two instructions, whatever the pointer says,
# and both are framed as the FIRST action of the turn — not something done
# after the work starts. Once the model has read a file or invoked a skill it
# is already committed to the request, and the question either never comes or
# arrives too late to tag the work:
#
#   1. Confirm at the start of the session. A ticket left over from a previous
#      session says nothing about what the user is doing now, so the ticket has
#      to be confirmed once per session before the request is handled: still
#      this one, another one, or no ticket at all. An unset pointer —
#      `/afyapowers:new` bootstraps the file EMPTY — is the same state, nobody
#      has been asked yet.
#
#   2. Re-confirm on a topic shift. A confirmation covers only the work it was
#      given for, never a new piece of work later in the same session — so a
#      prompt that changes the subject re-opens the question, again first.
#
# Both are deduped by instruction, not by state on disk: the messages say
# "unless you already asked in this session" and scope the re-ask per topic
# shift, and the model's own conversation memory does the bookkeeping. The hook
# stays stateless — it reads the pointer and the branch, and nothing else.
#
# Every answer must be written to `.afyapowers/current-jira-ticket`: it is what
# otel-context stamps on telemetry and what the statusline renders.

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

AFYA_DIR=".afyapowers"
JIRA_FILE="$AFYA_DIR/current-jira-ticket"
WRITE_RULES="Persist the answer to .afyapowers/current-jira-ticket (create the directory first if needed): the chosen key uppercase, single line, no trailing newline (e.g. ABC-123), or the literal none so the user is not asked again. If you had to create .afyapowers/, also write .afyapowers/.gitignore with one line each: features/active, history/, otel-debug.jsonl, current-jira-ticket."
# The tail every resolved-pointer message shares: a confirmation is scoped to
# the work it was given for.
SHIFT_RULES="After that, assess every prompt: the moment one starts a different piece of work — another task, feature or bug — asking again is once more the FIRST thing you do in that turn, before acting on it, even though the ticket was already confirmed in this session; a confirmation covers only the work it was given for, never a new topic shift. Tangents, follow-ups, questions and sub-tasks of the same work do not count as a shift."

# `/afyapowers:new` writes `.afyapowers/.gitignore`, but the ticket pointer is
# created outside that flow too — the instructions above tell the model to write
# it in any project, and `/new` may never run there. So top the file up on every
# prompt: cheap, idempotent, and it keeps the local pointer, the active-feature
# marker and the conversation logs out of version control. Never create
# `.afyapowers/` itself — its presence is what marks a project as
# afyapowers-enabled (same rule as render-history).
ensure_gitignore() {
  local gi="$AFYA_DIR/.gitignore" line trimmed existing="" missing="" found
  if [ ! -d "$AFYA_DIR" ]; then
    return 0
  fi
  if [ -f "$gi" ]; then
    existing=$(cat "$gi" 2>/dev/null || true)
  fi
  for line in features/active history/ otel-debug.jsonl current-jira-ticket; do
    found=""
    while IFS= read -r trimmed; do
      trimmed="${trimmed#"${trimmed%%[![:space:]]*}"}"
      trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
      if [ "$trimmed" = "$line" ]; then
        found=1
        break
      fi
    done <<< "$existing"
    if [ -z "$found" ]; then
      missing="${missing}${line}"$'\n'
    fi
  done
  if [ -z "$missing" ]; then
    return 0
  fi
  # `$(...)` strips a trailing newline, so an empty capture means the file
  # already ends with one.
  if [ -s "$gi" ] && [ -n "$(tail -c1 "$gi" 2>/dev/null || true)" ]; then
    printf '\n' >> "$gi" 2>/dev/null || true
  fi
  printf '%s' "$missing" >> "$gi" 2>/dev/null || true
}

# Outside a git repo otel-context never emits (git_attrs -> None skips the
# record), so a ticket would be collected and never sent — stay silent.
if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null || true)" != "true" ]; then
  exit 0
fi

ensure_gitignore

# Empty in detached HEAD. Every grep pipeline needs `|| true`: under pipefail
# a no-match grep kills the hook.
BRANCH=$(git branch --show-current 2>/dev/null || true)
BRANCH_KEY=$(printf '%s' "$BRANCH" | grep -oE '[A-Z][A-Z0-9]+-[0-9]+' | head -1 || true)

# File value: strip newlines like features/active; discard garbage (keep `none`).
# An empty file — the bootstrap default — falls through as unresolved, so the
# user is asked; only the literal `none` records "the user has no ticket".
FILE_KEY=""
if [ -f "$JIRA_FILE" ]; then
  FILE_KEY=$(tr -d '\n\r' < "$JIRA_FILE")
  if [ "$FILE_KEY" != "none" ] && ! printf '%s' "$FILE_KEY" | grep -qE '^[A-Z][A-Z0-9]+-[0-9]+$'; then
    FILE_KEY=""
  fi
fi

# The question is the first action of the turn, not a step in the work: it has
# to land before anything commits the model to the request.
PRIORITY="TOP PRIORITY — handle this before anything else in this turn."
ASK="Unless you already asked in this session, ask the user NOW — use the AskUserQuestion tool when available —"
BLOCK_RULES="Ask before you do anything else: no other tool call, no reading or searching files, no skill invocation, no plan or todo list, and no answer to any part of the request until the user has answered. Do not start the work and ask afterwards."

MSG=""
if [ -z "$FILE_KEY" ]; then
  # Unset: ask before handling the request.
  if [ -n "$BRANCH_KEY" ]; then
    MSG="${PRIORITY} The Jira ticket for this project is not set. ${ASK} which Jira ticket this work belongs to. Options: '${BRANCH_KEY} (from branch) (Recommended)', 'Another ticket id' (the user types it), 'No specific task'. ${BLOCK_RULES} ${WRITE_RULES}"
  else
    MSG="${PRIORITY} The Jira ticket for this project is not set. ${ASK} whether this work is tied to a Jira ticket. Options: 'No specific task (Recommended if unsure)', 'Yes, a specific ticket' (the user types the id, e.g. ABC-123). ${BLOCK_RULES} ${WRITE_RULES}"
  fi
elif [ -n "$BRANCH_KEY" ] && [ "$BRANCH_KEY" != "$FILE_KEY" ]; then
  # Conflict: the branch suggests a key the user has not confirmed.
  if [ "$FILE_KEY" = "none" ]; then
    RECORDED="the pointer records no specific task"
    CURRENT_OPT="'No specific task (current setting)', 'Another ticket id' (the user types it)"
  else
    RECORDED="the recorded ticket is ${FILE_KEY}"
    CURRENT_OPT="'Keep ${FILE_KEY} (current setting)', 'Another ticket id' (the user types it), 'No specific task'"
  fi
  MSG="${PRIORITY} The Jira ticket pointer conflicts with the git branch: ${RECORDED}, but the branch suggests ${BRANCH_KEY}. ${ASK} which applies. Options: '${BRANCH_KEY} (from branch) (Recommended)', ${CURRENT_OPT}. ${BLOCK_RULES} ${WRITE_RULES}"
elif [ "$FILE_KEY" = "none" ]; then
  # Resolved as no-task, but set in some earlier session: confirm once here,
  # then watch for the start of new work.
  MSG="${PRIORITY} Jira ticket: none (recorded as working without a ticket, possibly in an earlier session). ${ASK} whether they are working on a Jira ticket now. Options: 'Still no specific task (Recommended)', 'Yes, a specific ticket' (the user types the id, e.g. ABC-123). ${BLOCK_RULES} ${SHIFT_RULES} ${WRITE_RULES}"
else
  # Resolved with a key, possibly left over from an earlier session: confirm
  # once here, then watch for a task switch.
  MSG="${PRIORITY} Jira ticket: ${FILE_KEY} (recorded for this project, possibly in an earlier session). ${ASK} whether they are still working on ${FILE_KEY}. Options: 'Keep ${FILE_KEY} (Recommended)', 'Another ticket id' (the user types it), 'No specific task'. ${BLOCK_RULES} ${SHIFT_RULES} ${WRITE_RULES}"
fi

echo "{\"hookSpecificOutput\": {\"hookEventName\": \"UserPromptSubmit\", \"additionalContext\": \"$(json_escape "$MSG")\"}}"
exit 0
