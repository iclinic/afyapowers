{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "./hooks/session-start",
        "powershell": "bash ./hooks/session-start",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "./hooks/render-history github-copilot",
        "powershell": "bash ./hooks/render-history github-copilot",
        "cwd": ".",
        "timeoutSec": 30
      }
    ]
  }
}
