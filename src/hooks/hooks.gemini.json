{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$GEMINI_PROJECT_DIR/hooks/session-start"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "activate_skill",
        "hooks": [
          {
            "type": "command",
            "command": "$GEMINI_PROJECT_DIR/hooks/lang-directive gemini"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$GEMINI_PROJECT_DIR/hooks/render-history gemini"
          }
        ]
      }
    ]
  }
}
